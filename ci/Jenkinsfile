// Runs as a Jenkins Multibranch Pipeline, which sets BRANCH_NAME and, for a pull request, CHANGE_ID.
//
// - A pull request runs the tests, builds the image and scans it, then stops. Nothing is pushed or deployed.
// - main pushes the image, deploys it to dev, and then waits for someone to click Promote, which
//   deploys the same image to prod. Nothing is rebuilt for prod.

// Posts to Discord. The webhook URL is the Secret text credential discord-webhook-url, so Jenkins
// masks it in the build log. A string credential needs no workspace, so this also works in stages
// that run without an agent
def notifyDiscord(Map message) {
  withCredentials([string(credentialsId: 'discord-webhook-url', variable: 'DISCORD_WEBHOOK_URL')]) {
    discordSend(message + [webhookURL: env.DISCORD_WEBHOOK_URL])
  }
}

pipeline {
  // Only the Build stage takes an executor, so a build waiting for Promote doesn't hold one
  agent none

  options {
    buildDiscarder(logRotator(numToKeepStr: '30'))
  }

  environment {
    IMAGE_URL = "chatreejs/bill-please-ocr"
    DEV_DEPLOY_JOB = 'chatreejs/gitops/bill-please-backend-manifest-dev'
    PROD_DEPLOY_JOB = 'chatreejs/gitops/bill-please-backend-manifest-prod'
  }

  stages {
    stage('Build') {
      agent any

      stages {
        stage('Prepare Env') {
          steps {
            script {
              // Read the version from pyproject.toml with grep and sed, like the api pipeline reads package.json
              env.VERSION = sh(
                returnStdout: true,
                script: '''grep -m1 '^version' pyproject.toml | sed -E 's/version[[:space:]]*=[[:space:]]*"([^"]+)"/\\1/' '''
              ).trim()

              // Each main build gets its own tag, so prod runs the exact image that dev ran
              env.BUILD_VERSION = env.CHANGE_ID
                ? "${env.VERSION}-pr${env.CHANGE_ID}.${env.BUILD_NUMBER}"
                : "${env.VERSION}-${env.GIT_COMMIT.substring(0, 7)}"
              currentBuild.displayName += " version ${env.BUILD_VERSION}"
            }
          }
        }

        stage('Test') {
          agent {
            docker {
              // Keep in sync with .tool-versions
              image 'python:3.13.18-slim'
              args '-u root'
              reuseNode true
            }
          }
          steps {
            sh 'pip install --quiet uv==0.13.6'
            // The unit tests never load ONNX Runtime, so skip it and its 2 GB of CUDA wheels
            sh 'uv sync --frozen --no-install-package nvidia-cublas-cu12 --no-install-package nvidia-cuda-nvrtc-cu12 --no-install-package nvidia-cuda-runtime-cu12 --no-install-package nvidia-cudnn-cu12 --no-install-package nvidia-cufft-cu12 --no-install-package nvidia-curand-cu12 --no-install-package nvidia-nvjitlink-cu12 --no-install-package onnxruntime-gpu'
            sh 'uv run ruff check .'
            sh 'uv run ruff format --check .'
            // Unit tests only. The image build below loads the real models once as a smoke test.
            // coverage.xml is picked up by the Static Code Scan stage.
            sh 'uv run pytest -q --cov=receipt_ocr --cov-report=xml:coverage.xml'
          }
        }

        // SonarQube Community Edition can't analyze pull requests, so only main is scanned
        stage('Static Code Scan') {
          when { branch 'main' }
          agent {
            docker {
              image 'sonarsource/sonar-scanner-cli:latest'
              args '-u root --privileged'
              // Reuse the workspace, so the scanner reads coverage.xml from the Test stage
              reuseNode true
            }
          }
          steps {
            withSonarQubeEnv('SonarQube Server') {
              sh "sonar-scanner -Dsonar.projectVersion=${BUILD_VERSION}"
            }
          }
        }

        stage('Build Docker Image') {
          steps {
            // The build downloads the OCR models from Hugging Face, converts them to ONNX and loads them once
            sh 'docker build -f Dockerfile . -t ${IMAGE_URL}:${BUILD_VERSION}'
          }
        }

        stage('Image Vulnerability Scan') {
          agent {
            docker {
              image 'aquasec/trivy:latest'
              args '-v /var/run/docker.sock:/var/run/docker.sock -v trivy_cache:/.cache --entrypoint="" -u root --privileged'
              // Run on the node that built the image
              reuseNode true
            }
          }
          steps {
            sh 'trivy image --format template --template \"@/contrib/html.tpl\" --output report.html --severity HIGH,CRITICAL --no-progress ${IMAGE_URL}:${BUILD_VERSION}'

            publishHTML target : [
              allowMissing: true,
              alwaysLinkToLastBuild: false,
              keepAll: true,
              reportDir: '.',
              reportFiles: 'report.html',
              reportName: 'Trivy Scan Report',
            ]
          }
        }

        stage('Push to registry') {
          when { branch 'main' }
          steps {
            withCredentials([usernamePassword(credentialsId: 'docker-hub-credential', usernameVariable: 'USERNAME', passwordVariable: 'PASSWORD')]) {
              sh 'echo $PASSWORD | docker login -u $USERNAME --password-stdin'
              sh 'docker push ${IMAGE_URL}:${BUILD_VERSION}'
            }
          }
        }

        // The manifest repo bill-please-backend also deploys bill-please-api, which sets API_IMAGE_TAG
        stage('Deploy to dev') {
          when { branch 'main' }
          steps {
            build job: env.DEV_DEPLOY_JOB, parameters: [string(name: 'OCR_IMAGE_TAG', value: env.BUILD_VERSION)]
          }
          post {
            // The build only ends after Promote, so say now that dev has it
            success {
              script { notifyDiscord(description: "Deployed to dev. Open the build to promote it to production.", link: env.BUILD_URL, result: 'SUCCESS', title: "${env.JOB_NAME} - # ${env.BUILD_VERSION} on dev") }
            }
          }
        }
      }

      post {
        always {
          sh 'docker rmi ${IMAGE_URL}:${BUILD_VERSION} || true'
        }
      }
    }

    // Waits without an executor. Test the build on dev first. A build that nobody promotes within
    // 7 days ends as ABORTED and leaves prod as it was
    stage('Promote to production') {
      when { branch 'main' }
      options { timeout(time: 7, unit: 'DAYS') }
      steps {
        // The milestones stop an older build from deploying to prod after a newer one already has
        milestone(1)
        input message: "Deploy ${env.BUILD_VERSION} to production?", ok: 'Promote'
        milestone(2)
        build job: env.PROD_DEPLOY_JOB, parameters: [string(name: 'OCR_IMAGE_TAG', value: env.BUILD_VERSION)]
      }
    }
  }

  post {
    success {
      script { notifyDiscord(description: "Duration: ${currentBuild.durationString}", link: env.BUILD_URL, result: currentBuild.currentResult, title: "${env.JOB_NAME} - # ${env.BUILD_VERSION}", footer: "${currentBuild.getBuildCauses()[0].shortDescription}") }
    }
    failure {
      script { notifyDiscord(description: "Duration: ${currentBuild.durationString}", link: env.BUILD_URL, result: currentBuild.currentResult, title: "${env.JOB_NAME} - # ${env.BUILD_VERSION}", footer: "${currentBuild.getBuildCauses()[0].shortDescription}") }
    }
  }

}
